  "0_outline_lines": [
    "L036: \"ContractCommitment MUST adhere to the following requirements:\"",
    "  L038: \"ContractCommitment MUST be present when the service provider supports *contract commitments*.\"",
    "  L039: \"ContractCommitment column presence MUST adhere to the following requirements:\"",
    "    L040: \"ContractCommitment MUST include [BillingCurrency](#datasets.contractcommitment.billingcurrency).\"",
    "    L041: \"ContractCommitment MUST include [ContractCommitmentCategory](#datasets.contractcommitment.contractcommitmentcategory).\"",
    "    L042: \"ContractCommitment MUST include [ContractCommitmentCost](#datasets.contractcommitment.contractcommitmentcost).\"",
    "    L043: \"ContractCommitment MUST include [ContractCommitmentDescription](#datasets.contractcommitment.contractcommitmentdescription).\"",
    "    L044: \"ContractCommitment MUST include [ContractCommitmentId](#datasets.contractcommitment.contractcommitmentid).\"",
    "    L045: \"ContractCommitment MUST include [ContractCommitmentPeriodEnd](#datasets.contractcommitment.contractcommitmentperiodend).\"",
    "    L046: \"ContractCommitment MUST include [ContractCommitmentPeriodStart](#datasets.contractcommitment.contractcommitmentperiodstart).\"",
    "    L047: \"ContractCommitment MUST include [ContractCommitmentQuantity](#datasets.contractcommitment.contractcommitmentquantity).\"",
    "    L048: \"ContractCommitment MUST include [ContractCommitmentType](#datasets.contractcommitment.contractcommitmenttype).\"",
    "    L049: \"ContractCommitment MUST include [ContractCommitmentUnit](#datasets.contractcommitment.contractcommitmentunit).\"",
    "    L050: \"ContractCommitment MUST include [ContractId](#datasets.contractcommitment.contractid).\"",
    "    L051: \"ContractCommitment MUST include [ContractPeriodEnd](#datasets.contractcommitment.contractperiodend).\"",
    "    L052: \"ContractCommitment MUST include [ContractPeriodStart](#datasets.contractcommitment.contractperiodstart).\"",
    "  L053: \"ContractCommitment MUST conform to [ColumnHandling](#attributes.columnhandling) requirements.\"",
    "  L054: \"ContractCommitment MUST conform to [DatasetCompleteness](#attributes.datasetcompleteness) requirements.\"",
    "  L055: \"ContractCommitment MUST conform to [NullHandling](#attributes.nullhandling) requirements.\"",
    "  L056: \"ContractCommitment MUST conform to [DatasetConfiguration](#attributes.datasetconfiguration) requirements.\""
  ],
