  "0_outline_root": "ROOT: Commitment Eligibility Details > Requirements",
  "0_outline_lines": [
    "L007: \"CommitmentEligibilityDetails MUST adhere to the following requirements:\"",
    "  L009: \"CommitmentEligibilityDetails MUST be of type String.\"",
    "  L010: \"CommitmentEligibilityDetails MUST conform to [StringHandling](#attributes.stringhandling) requirements.\"",
    "  L011: \"CommitmentEligibilityDetails MUST conform to [JsonObjectFormat](#attributes.jsonobjectformat) requirements.\"",
    "  L012: \"CommitmentEligibilityDetails MUST NOT be null when a charge is eligible for a commitment program, regardless of whether a commitment was actually applied to the charge.\"",
    "  L013: \"CommitmentEligibilityDetails MUST NOT consider transient account configurations or quotas that might temporarily prevent purchase or participation in a commitment program.\"",
    "  L014: \"CommitmentEligibilityDetails MUST include all publicly available commitment programs for which the usage is eligible.\"",
    "  L015: \"CommitmentEligibilityDetails SHOULD include negotiated commitment programs for which the usage is eligible.\"",
    "  L016: \"CommitmentEligibilityDetails MUST NOT include data related to commitment [*periods*](#glossary:periods) or payment options.\"",
    "  L017: \"CommitmentEligibilityDetails MUST conform to [CommitmentEligibilityDetailsObject](#datasets.costandusage.commitmenteligibilitydetails.commitmenteligibilitydetailsobject) requirements when CommitmentEligibilityDetails is not null.\"",
    "L025: \"CommitmentEligibilityDetailsObject MUST adhere to the following requirements:\"",
    "  L026: \"CommitmentEligibilityDetailsObject MUST have at least one top-level property key when not null.\"",
    "  L027: \"CommitmentEligibilityDetailsObject MAY have a top-level property key \\\"CommitmentDiscountTypes\\\".\"",
    "  L028: \"CommitmentEligibilityDetailsObject MAY have a top-level property key \\\"CapacityReservationTypes\\\" for commitment programs whose primary purpose is to reserve capacity rather than to provide a unit discount.\"",
    "  L029: \"CommitmentEligibilityDetailsObject MAY contain additional data generator-defined top-level property keys for future or provider-specific commitment categories.\"",
    "  L030: \"CommitmentEligibilityDetailsObject MUST have property keys that begin with the string \\\"x\\\\_\\\" unless it is a FOCUS-defined property key.\"",
    "  L031: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes MUST adhere to the following requirements:\"",
    "    L032: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes MUST be of type Array.\"",
    "    L033: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes MUST contain one or more objects.\"",
    "    L034: \"Each entry in CommitmentEligibilityDetailsObject.CommitmentDiscountTypes MUST be of type JSON Object.\"",
    "    L035: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes MUST have a property key \\\"Type\\\".\"",
    "    L036: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes MAY contain additional data generator-defined property keys.\"",
    "    L037: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes MUST have property keys that begin with the string \\\"x\\\\_\\\" unless it is a FOCUS-defined property key.\"",
    "    L038: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes.Type MUST be of type String.\"",
    "    L039: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes.Type MUST NOT be null.\"",
    "    L040: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes.Type MUST correspond to a commitment program type supported by the provider (e.g., \\\"SavingsPlan\\\", \\\"ReservedInstance\\\", \\\"CommittedUseDiscount\\\").\"",
    "    L041: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes.Type MUST be consistent with strings used in [CommitmentDiscountType](#datasets.costandusage.commitmentdiscounttype) when CommitmentDiscountType is populated by the provider.\"",
    "    L042: \"CommitmentEligibilityDetailsObject.CommitmentDiscountTypes.Type SHOULD correspond to terminology disclosed by the provider in public documentation when CommitmentDiscountType is not populated by the provider.\"",
    "  L043: \"CommitmentEligibilityDetailsObject.CapacityReservationTypes MUST adhere to the following requirements:\"",
    "    L044: \"CommitmentEligibilityDetailsObject.CapacityReservationTypes MUST be of type Array.\"",
    "    L045: \"CommitmentEligibilityDetailsObject.CapacityReservationTypes MUST contain one or more objects.\"",
    "    L046: \"Each entry in CommitmentEligibilityDetailsObject.CapacityReservationTypes MUST be of type JSON Object.\"",
    "    L047: \"CommitmentEligibilityDetailsObject.CapacityReservationTypes MUST have a property key \\\"Type\\\".\"",
    "    L048: \"CommitmentEligibilityDetailsObject.CapacityReservationTypes MAY contain additional data generator-defined property keys.\"",
    "    L049: \"CommitmentEligibilityDetailsObject.CapacityReservationTypes MUST have property keys that begin with the string \\\"x\\\\_\\\" unless it is a FOCUS-defined property key.\"",
    "    L050: \"CommitmentEligibilityDetailsObject.CapacityReservationTypes.Type MUST be of type String.\"",
    "    L051: \"CommitmentEligibilityDetailsObject.CapacityReservationTypes.Type MUST NOT be null.\"",
    "    L052: \"CommitmentEligibilityDetailsObject.CapacityReservationTypes.Type MUST correspond to a capacity-reservation-style commitment program supported by the provider (for example, \\\"CapacityReservation\\\", \\\"ZonalReservation\\\").\""
  ],
