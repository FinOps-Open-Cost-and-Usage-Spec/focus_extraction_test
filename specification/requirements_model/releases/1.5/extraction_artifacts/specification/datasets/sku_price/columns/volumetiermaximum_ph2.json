  "0_outline_root": "ROOT: Volume Tier Maximum > Requirements",
  "0_outline_lines": [
    "L009: \"VolumeTierMaximum MUST adhere to the following requirements:\"",
    "  L011: \"VolumeTierMaximum MUST be of type Decimal.\"",
    "  L012: \"VolumeTierMaximum MUST adhere to the following nullability requirements:\"",
    "    L013: \"VolumeTierMaximum MUST be null when there is no upper limit for the pricing tier.\"",
    "    L014: \"VolumeTierMaximum MUST NOT be null when a subsequent, higher-volume pricing tier exists for the same offering.\"",
    "  L015: \"When VolumeTierMaximum is not null, VolumeTierMaximum MUST adhere to the following requirements:\"",
    "    L016: \"VolumeTierMaximum MUST represent a quantity denominated in the [PricingUnit](#datasets.skuprice.pricingunit).\"",
    "    L017: \"VolumeTierMaximum MUST be strictly greater than [VolumeTierMinimum](#datasets.skuprice.volumetierminimum).\"",
    "    L018: \"VolumeTierMaximum MUST be the exclusive upper bound of the volume-based pricing tier.\""
  ],
