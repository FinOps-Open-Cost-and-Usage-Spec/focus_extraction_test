  "0_outline_root": "ROOT: Unit Price Category > Requirements",
  "0_outline_lines": [
    "L007: \"UnitPriceCategory MUST adhere to the following requirements:\"",
    "  L009: \"UnitPriceCategory MUST be of type String.\"",
    "  L010: \"UnitPriceCategory MUST conform to [StringHandling](#attributes.stringhandling) requirements.\"",
    "  L011: \"UnitPriceCategory MUST NOT be null.\"",
    "  L012: \"UnitPriceCategory MUST be one of the allowed values.\"",
    "  L013: \"UnitPriceCategory MUST be \\\"List\\\" when the unit price is the standard, current public rate offered by the service provider.\"",
    "  L014: \"UnitPriceCategory MUST be \\\"Fixed List\\\" when the unit price is a standard public rate that has been locked or frozen for a specific agreement or timeframe.\"",
    "  L015: \"UnitPriceCategory MUST be \\\"Contracted\\\" when the unit price is a negotiated or custom rate specific to a billing account or agreement.\""
  ],
