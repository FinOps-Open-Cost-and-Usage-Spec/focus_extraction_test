  "0_outline_root": "ROOT: SKU Price Eligibility > Requirements",
  "0_outline_lines": [
    "L009: \"SkuPriceEligibility MUST adhere to the following requirements:\"",
    "  L011: \"SkuPriceEligibility MUST be of type JSON Object (serialized as a String where necessary).\"",
    "  L012: \"SkuPriceEligibility MUST conform to [StringHandling](#attributes.stringhandling) requirements.\"",
    "  L013: \"SkuPriceEligibility MUST conform to [JsonObjectFormat](#attributes.jsonobjectformat) requirements.\"",
    "  L014: \"SkuPriceEligibility MUST conform to [SkuPriceEligibilityObject](#datasets.skuprice.skupriceeligibility.skupriceeligibilityobject) requirements.\"",
    "  L015: \"SkuPriceEligibility MUST NOT be null.\"",
    "L025: \"SkuPriceEligibilityObject MUST adhere to the following requirements:\"",
    "  L027: \"SkuPriceEligibilityObject MUST conform to the [SkuPriceEligibilityObjectSchema](#schemas.skuprice.skupriceeligibilityobjectschema) JSON Schema.\"",
    "  L028: \"SkuPriceEligibilityObject.IsGlobalScope MUST be `true` when the *SKU Price* applies to all entities without restriction (e.g., a standard public list price).\"",
    "  L029: \"SkuPriceEligibilityObject.IsComplexScope MUST be `true` when the *SKU Price's* eligibility logic exceeds schema capabilities.\"",
    "  L030: \"SkuPriceEligibilityObject.Inclusions[*].Dimension SHOULD represent a column in [Cost and Usage](#datasets.costandusage).\"",
    "  L031: \"SkuPriceEligibilityObject.Exclusions[*].Dimension SHOULD represent a column in [Cost and Usage](#datasets.costandusage).\"",
    "  L032: \"SkuPriceEligibilityObject.Inclusions[*].Values MUST contain only the single string \\\"*\\\" when the wildcard is present.\"",
    "  L033: \"SkuPriceEligibilityObject.Exclusions[*].Values MUST contain only the single string \\\"*\\\" when the wildcard is present.\""
  ],
