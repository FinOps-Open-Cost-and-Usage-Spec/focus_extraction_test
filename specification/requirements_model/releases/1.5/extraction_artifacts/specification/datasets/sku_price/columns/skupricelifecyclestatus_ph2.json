  "0_outline_root": "ROOT: SKU Price Lifecycle Status > Requirements",
  "0_outline_lines": [
    "L007: \"SkuPriceLifecycleStatus MUST adhere to the following requirements:\"",
    "  L009: \"SkuPriceLifecycleStatus MUST be of type String.\"",
    "  L010: \"SkuPriceLifecycleStatus MUST conform to [StringHandling](#attributes.stringhandling) requirements.\"",
    "  L011: \"SkuPriceLifecycleStatus MUST NOT be null.\"",
    "  L012: \"SkuPriceLifecycleStatus MUST be one of the allowed values.\"",
    "  L013: \"SkuPriceLifecycleStatus MUST be \\\"Active\\\" when the *SKU Price* is currently effective and available for use or purchase.\"",
    "  L014: \"SkuPriceLifecycleStatus MUST be \\\"Preview\\\" when the *SKU Price* applies to an offering in a pre-release, beta, or early access state.\"",
    "  L015: \"SkuPriceLifecycleStatus MUST be \\\"Deprecated\\\" when the *SKU Price* is still valid for existing deployments but is slated for retirement or no longer available for new consumption.\"",
    "  L016: \"SkuPriceLifecycleStatus MUST be \\\"Inactive\\\" when the *SKU Price* is temporarily suspended or disabled but not permanently retired.\"",
    "  L017: \"SkuPriceLifecycleStatus MUST be \\\"Archived\\\" when the *SKU Price* is permanently retired, superseded, or no longer effective.\"",
    "  L018: \"SkuPriceLifecycleStatus MUST be \\\"Other\\\" when there is a lifecycle state but none of the allowed values apply.\""
  ],
