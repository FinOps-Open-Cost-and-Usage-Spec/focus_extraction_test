  "0_outline_lines": [
    "L009: \"SkuPriceEffectiveStart MUST adhere to the following requirements:\"",
    "  L011: \"SkuPriceEffectiveStart MUST be of type Date/Time.\"",
    "  L012: \"SkuPriceEffectiveStart MUST conform to [DateTimeFormat](#attributes.date/timeformat) requirements (e.g., UTC).\"",
    "  L013: \"SkuPriceEffectiveStart MAY be null when the *service provider* does not specify the date from which the unit price became applicable.\"",
    "  L014: \"When SkuPriceEffectiveStart is not null, SkuPriceEffectiveStart MUST represent the exact timestamp designated by the *service provider* from which the unit price is applicable.\""
