  "0_outline_lines": [
    "L013: \"PrincipalId MUST adhere to the following requirements:\"",
    "  L015: \"PrincipalId MUST be of type String.\"",
    "  L016: \"PrincipalId MUST conform to [StringHandling](#attributes.stringhandling) requirements.\"",
    "  L017: \"PrincipalId MUST adhere to the following nullability requirements:\"",
    "    L018: \"PrincipalId MUST be null when a *charge* is not attributed to a *principal* by the service provider.\"",
