  "0_outline_root": "ROOT: Allocated Resource ID > Requirements",
  "0_outline_lines": [
    "L007: \"AllocatedResourceId MUST adhere to the following requirements:\"",
    "  L009: \"AllocatedResourceId MUST be of type String.\"",
    "  L010: \"AllocatedResourceId MUST conform to [StringHandling](#attributes.stringhandling) requirements.\"",
    "  L011: \"AllocatedResourceId MUST adhere to the following nullability requirements:\"",
    "    L012: \"AllocatedResourceId MUST be null when a *charge* is not related to a data generator-calculated split cost allocation.\"",
    "    L013: \"AllocatedResourceId MUST be null when a *charge* represents the unallocated portion of the origin *charge* after split cost allocation.\"",
    "    L014: \"AllocatedResourceId MUST NOT be null when a *charge* represents the allocated portion of the origin *charge*.\"",
    "  L015: \"When AllocatedResourceId is not null, AllocatedResourceId MUST adhere to the following requirements:\"",
    "    L016: \"AllocatedResourceId SHOULD be a locally unique identifier within the associated ResourceId and ChargePeriod.\"",
    "    L017: \"AllocatedResourceId MAY NOT be unique across ResourceId or ChargePeriod values.\""
  ],
