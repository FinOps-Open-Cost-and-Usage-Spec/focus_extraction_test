  "0_outline_lines": [
    "L007: \"CommitmentDiscountStatus MUST adhere to the following requirements:\"",
    "  L009: \"CommitmentDiscountStatus MUST be of type String.\"",
    "  L010: \"CommitmentDiscountStatus MUST adhere to the following nullability requirements:\"",
    "    L011: \"CommitmentDiscountStatus MUST be null when [CommitmentDiscountId](#datasets.costandusage.commitmentdiscountid) is null.\"",
    "    L012: \"CommitmentDiscountStatus MUST NOT be null when CommitmentDiscountId is not null and [Charge Category](#datasets.costandusage.chargecategory) is \\\"Usage\\\".\"",
    "  L013: \"CommitmentDiscountStatus MUST be one of the allowed values.\"",
    "  L014: \"CommitmentDiscountStatus MUST be \\\"Used\\\" when the *charge* utilizes a specific amount of a given CommitmentDiscountId.\"",
    "  L015: \"CommitmentDiscountStatus MUST be \\\"Unused\\\" when the *charge* represents the unused portion of the given CommitmentDiscountId.\""
  ],
