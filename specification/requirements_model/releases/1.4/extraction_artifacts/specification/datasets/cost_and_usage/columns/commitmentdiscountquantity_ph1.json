    {
      "temp_id": "R011",
      "order": 11,
      "text": "When CommitmentDiscountQuantity is not null and ChargeCategory is \"Purchase\", CommitmentDiscountQuantity MUST adhere to the following requirements:",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
