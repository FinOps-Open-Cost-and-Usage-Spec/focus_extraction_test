    {
      "temp_id": "R013",
      "order": 13,
      "text": "CommitmentDiscountQuantity MUST be the quantity of CommitmentDiscountUnit that is eligible for consumption for each *charge period* that corresponds with the purchase when ChargeFrequency is \"Recurring\".",
