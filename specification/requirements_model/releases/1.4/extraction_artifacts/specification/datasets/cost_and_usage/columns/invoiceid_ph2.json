  "0_outline_root": "ROOT: Invoice ID > Requirements",
  "0_outline_lines": [
    "L007: \"InvoiceId MUST adhere to the following requirements:\"",
    "  L009: \"InvoiceId MUST be of type String.\"",
    "  L010: \"InvoiceId MUST conform to [StringHandling](#attributes.stringhandling) requirements.\"",
    "  L011: \"InvoiceId MUST adhere to the following nullability requirements:\"",
    "    L012: \"InvoiceId MUST be null when the *charge* is not associated either with an invoice or with a pre-generated provisional invoice.\"",
    "    L013: \"InvoiceId MUST NOT be null when the *charge* is associated with either an issued invoice or a pre-generated provisional invoice.\"",
    "  L014: \"InvoiceId MAY be generated prior to an invoice being issued.\"",
    "  L015: \"InvoiceId MUST be associated with the related *charge* and BillingAccountId when a pre-generated invoice or provisional invoice exists.\""
  ],
