  "0_outline_root": "ROOT: Commitment Discount Quantity > Requirements",
  "0_outline_lines": [
    "L009: \"CommitmentDiscountQuantity MUST adhere to the following requirements:\"",
    "  L011: \"CommitmentDiscountQuantity MUST be of type Decimal.\"",
    "  L012: \"CommitmentDiscountQuantity MUST conform to [NumericFormat](#attributes.numericformat) requirements.\"",
    "  L013: \"CommitmentDiscountQuantity MUST adhere to the following nullability requirements:\"",
    "    L014: \"CommitmentDiscountQuantity MUST be null when [SkuPriceId](#datasets.costandusage.skupriceid) is null.\"",
    "    L015: \"When ChargeCategory is \\\"Usage\\\" or \\\"Purchase\\\" and CommitmentDiscountId is not null, CommitmentDiscountQuantity MUST adhere to the following requirements:\"",
    "      L016: \"CommitmentDiscountQuantity MUST NOT be null when [ChargeClass](#datasets.costandusage.chargeclass) is not \\\"Correction\\\".\"",
    "      L017: \"CommitmentDiscountQuantity MAY be null when ChargeClass is \\\"Correction\\\".\"",
    "    L018: \"CommitmentDiscountQuantity MUST be null in all other cases.\"",
    "  L019: \"CommitmentDiscountQuantity MUST be a valid decimal value when not null.\"",
    "  L020: \"When CommitmentDiscountQuantity is not null and ChargeCategory is \\\"Purchase\\\", CommitmentDiscountQuantity MUST adhere to the following requirements:\"",
    "    L021: \"CommitmentDiscountQuantity MUST be the quantity of CommitmentDiscountUnit, paid fully or partially upfront, that is eligible for consumption over the *commitment discount's* *term* when [ChargeFrequency](#datasets.costandusage.chargefrequency) is \\\"One-Time\\\".\"",
    "    L022: \"CommitmentDiscountQuantity MUST be the quantity of CommitmentDiscountUnit that is eligible for consumption for each *charge period* that corresponds with the purchase when ChargeFrequency is \\\"Recurring\\\".\"",
    "  L023: \"When CommitmentDiscountQuantity is not null and ChargeCategory is \\\"Usage\\\", CommitmentDiscountQuantity MUST adhere to the following additional requirements:\"",
    "    L024: \"CommitmentDiscountQuantity MUST be the metered quantity of CommitmentDiscountUnit that is consumed in a given *charge period* when [CommitmentDiscountStatus](#datasets.costandusage.commitmentdiscountstatus) is \\\"Used\\\".\"",
    "    L025: \"CommitmentDiscountQuantity MUST be the remaining, unused quantity of CommitmentDiscountUnit in a given *charge period* when CommitmentDiscountStatus is \\\"Unused\\\".\""
  ],
