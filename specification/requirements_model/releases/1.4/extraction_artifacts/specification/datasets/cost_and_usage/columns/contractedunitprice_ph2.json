  "0_outline_root": "ROOT: Contracted Unit Price > Requirements",
  "0_outline_lines": [
    "L007: \"ContractedUnitPrice MUST adhere to the following requirements:\"",
    "  L009: \"ContractedUnitPrice MUST adhere to the following requirements:\"",
    "  L010: \"ContractedUnitPrice MUST be of type Decimal.\"",
    "  L011: \"ContractedUnitPrice MUST conform to [NumericFormat](#attributes.numericformat) requirements.\"",
    "  L012: \"ContractedUnitPrice MUST adhere to the following nullability requirements:\"",
    "    L013: \"ContractedUnitPrice MUST be null when [SkuPriceId](#datasets.costandusage.skupriceid) is null.\"",
    "    L014: \"ContractedUnitPrice MUST be null when [ChargeCategory](#datasets.costandusage.chargecategory) is \\\"Tax\\\".\"",
    "    L015: \"ContractedUnitPrice MUST NOT be null when [SkuPriceId](#datasets.costandusage.skupriceid) is not null.\"",
    "    L016: \"ContractedUnitPrice MUST NOT be null when ChargeCategory is \\\"Usage\\\" or \\\"Purchase\\\" and [ChargeClass](#datasets.costandusage.chargeclass) is not \\\"Correction\\\".\"",
    "    L017: \"ContractedUnitPrice MAY be null in all other cases.\"",
    "  L018: \"When ContractedUnitPrice is not null, ContractedUnitPrice MUST adhere to the following requirements:\"",
    "    L019: \"ContractedUnitPrice MUST be a non-negative decimal value.\"",
    "    L020: \"ContractedUnitPrice MUST be denominated in the BillingCurrency.\"",
    "  L021: \"[ContractedCost](#datasets.costandusage.contractedcost) MUST equal the product of ContractedUnitPrice and [PricingQuantity](#datasets.costandusage.pricingquantity) when ContractedUnitPrice is not null and PricingQuantity is not null.\""
  ],
