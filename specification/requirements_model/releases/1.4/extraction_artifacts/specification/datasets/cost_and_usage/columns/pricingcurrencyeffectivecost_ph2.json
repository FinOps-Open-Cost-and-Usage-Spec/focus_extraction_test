  "0_outline_lines": [
    "L011: \"PricingCurrencyEffectiveCost MUST adhere to the following requirements:\"",
    "  L013: \"PricingCurrencyEffectiveCost presence in a Cost and Usage [*FOCUS dataset*](#glossary:FOCUS-dataset) MUST adhere to the following presence requirements:\"",
    "    L014: \"PricingCurrencyEffectiveCost SHOULD be present in a Cost and Usage *FOCUS dataset* when the service provider supports pricing and billing in different currencies and publishes unit prices exclusive of discounts.\"",
    "    L015: \"PricingCurrencyEffectiveCost MAY be present in a Cost and Usage *FOCUS dataset* in all other cases.\"",
    "  L016: \"PricingCurrencyEffectiveCost MUST be of type Decimal.\"",
    "  L017: \"PricingCurrencyEffectiveCost MUST conform to [NumericFormat](#attributes.numericformat) requirements.\"",
    "  L018: \"PricingCurrencyEffectiveCost MUST NOT be null.\"",
    "  L019: \"PricingCurrencyEffectiveCost MUST be denominated in the [PricingCurrency](#datasets.costandusage.pricingcurrency).\"",
    "  L020: \"PricingCurrencyEffectiveCost MUST be the PricingCurrency-denominated equivalent of [EffectiveCost](#datasets.costandusage.effectivecost).\""
  ],
