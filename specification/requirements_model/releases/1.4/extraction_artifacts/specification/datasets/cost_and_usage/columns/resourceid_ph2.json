  "0_outline_root": "ROOT: Resource ID > Requirements",
  "0_outline_lines": [
    "L007: \"ResourceId MUST adhere to the following requirements:\"",
    "  L009: \"ResourceId MUST be of type String.\"",
    "  L010: \"ResourceId MUST conform to [StringHandling](#attributes.stringhandling) requirements.\"",
    "  L011: \"ResourceId MUST adhere to the following nullability requirements:\"",
    "    L012: \"ResourceId MUST be null when a [*charge*](#glossary:charge) is not related to a *resource*.\"",
    "    L013: \"ResourceId MUST NOT be null when a *charge* is related to a *resource*.\"",
    "  L014: \"When ResourceId is not null, ResourceId MUST adhere to the following requirements:\"",
    "    L015: \"ResourceId MUST be a unique identifier within the service provider.\"",
    "    L016: \"ResourceId SHOULD be a fully-qualified identifier.\"",
    "    L017: \"ResourceId MUST be the identifier of the *resource* that received the [*commitment discount*](#glossary:commitment-discount) when [CommitmentDiscountStatus](#datasets.costandusage.commitmentdiscountstatus) is \\\"Used\\\".\""
  ],
