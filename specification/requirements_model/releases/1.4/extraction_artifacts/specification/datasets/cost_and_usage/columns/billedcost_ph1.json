      },
      "provenance": {
        "line_start": 19,
        "line_end": 19
      },
      "_alignment_status": "confirmed",
      "ref": "L019"
    },
    {
      "temp_id": "R009",
      "order": 9,
      "text": "BilledCost MUST reflect amounts as invoiced by the [InvoiceIssuerName](#datasets.costandusage.invoiceissuername), not estimated or inferred values.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Billed Cost",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
        "bullet": "*"
      },
      "lead_in": {
