      },
      "provenance": {
        "line_start": 21,
        "line_end": 21
      },
      "_alignment_status": "confirmed",
      "ref": "L021"
    },
    {
      "temp_id": "R011",
      "order": 11,
      "text": "The sum of BilledCost for a given [InvoiceId](#datasets.costandusage.invoiceid) and InvoiceIssuerName MUST NOT differ from the payable amount provided on the corresponding invoice by more than the [Rounding Variance Tolerance](#appendix.roundingvariancetolerance) when the corresponding invoice has been issued.",
      "keyword": "MUST NOT",
      "role": "requirement",
      "section_path": [
        "Billed Cost",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
        "bullet": "*"
