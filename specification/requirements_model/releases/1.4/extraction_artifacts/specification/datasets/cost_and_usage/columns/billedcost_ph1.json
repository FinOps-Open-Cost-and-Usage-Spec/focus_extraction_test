      },
      "provenance": {
        "line_start": 20,
        "line_end": 20
      },
      "_alignment_status": "confirmed",
      "ref": "L020"
    },
    {
      "temp_id": "R010",
      "order": 10,
      "text": "BilledCost MUST be 0 for *charges* generated by entities that are not responsible or authorized for invoicing, to avoid double-counting when merging multiple datasets.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Billed Cost",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
        "bullet": "*"
      },
      "lead_in": {
