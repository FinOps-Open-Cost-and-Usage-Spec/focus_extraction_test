      },
      "_alignment_status": "confirmed",
      "ref": "L017"
    },
    {
      "temp_id": "R007",
      "order": 7,
      "text": "BilledCost MUST NOT include any portion of a [*covered charge*](#glossary:covered-charge) that is offset by a [*covering charge*](#glossary:covering-charge).",
      "keyword": "MUST NOT",
      "role": "requirement",
      "section_path": [
        "Billed Cost",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
