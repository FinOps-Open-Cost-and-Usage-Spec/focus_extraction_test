      "_alignment_status": "confirmed",
      "ref": "L018"
    },
    {
      "temp_id": "R008",
      "order": 8,
      "text": "BilledCost MUST be 0 for *charges* that are fully *covered* by one or more *covering charges*.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Billed Cost",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
        "bullet": "*"
      },
      "lead_in": {
