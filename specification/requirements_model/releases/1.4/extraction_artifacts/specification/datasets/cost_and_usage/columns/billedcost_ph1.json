      "ref": "L016"
    },
    {
      "temp_id": "R006",
      "order": 6,
      "text": "BilledCost MUST reflect all applicable pricing adjustments, including but not limited to *negotiated discounts*, *commitment discounts*, and other applicable discount programs.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Billed Cost",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
