  "0_outline_root": "ROOT: Consumed Quantity > Requirements",
  "0_outline_lines": [
    "L007: \"ConsumedQuantity MUST adhere to the following requirements:\"",
    "  L009: \"ConsumedQuantity MUST be of type Decimal.\"",
    "  L010: \"ConsumedQuantity MUST conform to [NumericFormat](#attributes.numericformat) requirements.\"",
    "  L011: \"ConsumedQuantity MUST adhere to the following nullability requirements:\"",
    "    L012: \"ConsumedQuantity MUST be null when [SkuPriceId](#datasets.costandusage.skupriceid) is null.\"",
    "    L013: \"ConsumedQuantity MUST be null when [ChargeCategory](#datasets.costandusage.chargecategory) is not \\\"Usage\\\", or when ChargeCategory is \\\"Usage\\\" and [CommitmentDiscountStatus](#datasets.costandusage.commitmentdiscountstatus) is \\\"Unused\\\".\"",
    "    L014: \"When ChargeCategory is \\\"Usage\\\" and CommitmentDiscountStatus is not \\\"Unused\\\", ConsumedQuantity MUST adhere to the following additional requirements:\"",
    "      L015: \"ConsumedQuantity MUST NOT be null when [ChargeClass](#datasets.costandusage.chargeclass) is not \\\"Correction\\\".\"",
    "      L016: \"ConsumedQuantity MAY be null when ChargeClass is \\\"Correction\\\".\"",
    "  L017: \"ConsumedQuantity MUST be a valid decimal value when not null.\""
  ],
