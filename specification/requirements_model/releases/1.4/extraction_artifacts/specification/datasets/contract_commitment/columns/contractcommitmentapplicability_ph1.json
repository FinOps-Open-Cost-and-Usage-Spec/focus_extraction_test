      },
      "ref": "L137"
    },
    {
      "temp_id": "R022",
      "order": 22,
      "text": "If multiple rules match under `Or`, the engine MUST use the highest percentage for each respective metric.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Contract Commitment Applicability",
        "Implementation Guidance",
        "Processing Workflow"
