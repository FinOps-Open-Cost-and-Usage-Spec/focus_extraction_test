    {
      "temp_id": "R019",
      "order": 19,
      "text": "The evaluation of an entity against a commitment applicability MUST follow a strict linear progression:",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Contract Commitment Applicability",
        "Implementation Guidance",
