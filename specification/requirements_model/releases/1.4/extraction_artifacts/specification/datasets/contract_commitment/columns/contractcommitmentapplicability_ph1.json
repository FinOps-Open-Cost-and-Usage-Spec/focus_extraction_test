      "ref": "L129"
    },
    {
      "temp_id": "R020",
      "order": 20,
      "text": "If a metric key (`Cost` or `Usage`) is missing within a provided `Applicability` object, the engine MUST default that specific value to `1.0`.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Contract Commitment Applicability",
        "Implementation Guidance",
        "Processing Workflow"
      ],
      "block": {
