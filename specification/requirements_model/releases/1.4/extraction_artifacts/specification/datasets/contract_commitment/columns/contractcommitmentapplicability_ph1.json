      },
      "ref": "L136"
    },
    {
      "temp_id": "R021",
      "order": 21,
      "text": "Use the `Applicability` from the matching inclusion rule.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Contract Commitment Applicability",
        "Implementation Guidance",
        "Processing Workflow"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
