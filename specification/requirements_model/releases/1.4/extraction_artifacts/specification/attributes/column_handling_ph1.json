    {
      "temp_id": "R001",
      "order": 1,
      "text": "All columns defined in the FOCUS specification MUST follow the naming and documentation requirements listed below.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling"
      ],
      "block": {
