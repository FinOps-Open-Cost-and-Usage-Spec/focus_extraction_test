      },
      "ref": "L016"
    },
    {
      "temp_id": "R002",
      "order": 2,
      "text": "All columns defined by FOCUS MUST follow the following rules:",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": true
      },
      "provenance": {
        "line_start": 34,
        "line_end": 34
      },
      "ref": "L034"
    },
    {
      "temp_id": "R003",
      "order": 3,
      "text": "Column IDs MUST use [Pascal case](#glossary:pascalcase).",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 35,
        "line_end": 35
      },
      "ref": "L035"
    },
    {
      "temp_id": "R004",
      "order": 4,
      "text": "Column IDs MUST NOT use abbreviations.",
      "keyword": "MUST NOT",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 36,
        "line_end": 36
      },
      "ref": "L036"
    },
    {
      "temp_id": "R005",
      "order": 5,
      "text": "Column IDs MUST be alphanumeric with no special characters.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 37,
        "line_end": 37
      },
      "ref": "L037"
    },
    {
      "temp_id": "R006",
      "order": 6,
      "text": "Column IDs SHOULD NOT use acronyms.",
      "keyword": "SHOULD NOT",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 38,
        "line_end": 38
      },
      "ref": "L038"
    },
    {
      "temp_id": "R007",
      "order": 7,
      "text": "Column IDs SHOULD NOT exceed 50 characters to accommodate column length restrictions of various data repositories.",
      "keyword": "SHOULD NOT",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 39,
        "line_end": 39
      },
      "ref": "L039"
    },
    {
      "temp_id": "R008",
      "order": 8,
      "text": "Columns that have an ID and a Name MUST have the `Id` or `Name` suffix in the Column ID.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 40,
        "line_end": 40
      },
      "ref": "L040"
    },
    {
      "temp_id": "R009",
      "order": 9,
      "text": "Column display names MUST be consistent with their Column IDs, with spaces inserted between words (e.g., Column ID \"BillingAccountName\" and display name \"Billing Account Name\").",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 41,
        "line_end": 41
      },
      "ref": "L041"
    },
    {
      "temp_id": "R010",
      "order": 10,
      "text": "Columns with the `Category` suffix MUST be normalized.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 42,
        "line_end": 42
      },
      "ref": "L042"
    },
    {
      "temp_id": "R011",
      "order": 11,
      "text": "Custom (e.g., service-provider-defined) columns that are not defined by FOCUS but included in a *FOCUS dataset* MUST follow the following rules:",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": true
      },
      "provenance": {
        "line_start": 43,
        "line_end": 43
      },
      "ref": "L043"
    },
    {
      "temp_id": "R012",
      "order": 12,
      "text": "Custom columns MUST be prefixed with a consistent `x_` prefix to identify them as external, custom columns and distinguish them from FOCUS columns to avoid conflicts in future releases.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 44,
        "line_end": 44
      },
      "ref": "L044"
    },
    {
      "temp_id": "R013",
      "order": 13,
      "text": "Custom columns SHOULD follow the same rules listed above for FOCUS columns.",
      "keyword": "SHOULD",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 45,
        "line_end": 45
      },
      "ref": "L045"
    },
    {
      "temp_id": "R014",
      "order": 14,
      "text": "Custom columns MUST be documented, including description, purpose, and relationship to [*native dataset*](#glossary:native-dataset) columns.",
      "keyword": "MUST",
      "role": "requirement",
