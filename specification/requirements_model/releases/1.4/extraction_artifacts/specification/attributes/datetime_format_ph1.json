    },
    {
      "temp_id": "R004",
      "order": 4,
      "text": "When column represents a specific moment in time, *FOCUS dataset column* MUST adhere to the following requirements:",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Date/Time Format",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
        "bullet": "*"
