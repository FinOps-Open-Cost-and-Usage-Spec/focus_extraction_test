      },
      "_alignment_status": "confirmed",
      "ref": "L011"
    },
    {
      "temp_id": "R005",
      "order": 5,
      "text": "*FOCUS dataset column* MUST use the extended ISO 8601 format with UTC offset (`YYYY-MM-DDTHH:mm:ssZ`).",
      "keyword": "MUST",
