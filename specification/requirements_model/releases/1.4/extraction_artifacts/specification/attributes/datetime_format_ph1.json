    },
    {
      "temp_id": "R003",
      "order": 3,
      "text": "*FOCUS dataset column* MUST conform to the ISO 8601 standard, which provides a globally recognized format for representing dates and times (see [ISO 8601-1:2019](https://www.iso.org/standard/70907.html) governing document for details).",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
