  "0_outline_root": "ROOT: Numeric Format > Requirements",
  "0_outline_lines": [
    "L007: \"Column conforming to NumericFormat attribute MUST adhere to the following requirements:\"",
    "  L009: \"[*FOCUS dataset column*](#glossary:FOCUS-dataset-column) MUST contain a single numeric value.\"",
    "  L010: \"*FOCUS dataset column* MUST have values of type integer, decimal, or scientific notation.\"",
    "  L011: \"*FOCUS dataset column* MUST contain values that, when not null, conform to one of the allowed Data Types defined in the table below.\"",
    "  L012: \"*FOCUS dataset column* MUST contain values that, when not null, conform to one of the allowed precision levels (and scale, where applicable) defined in the table below.\"",
    "  L013: \"*FOCUS dataset column* MUST NOT use mathematical symbols, functions, or operators, except for a negative sign (-) to indicate a negative value or a negative exponent in scientific notation.\"",
    "  L014: \"*FOCUS dataset column* MUST NOT include additional characters or qualifiers (e.g., currency symbols, units of measure).\"",
    "  L015: \"*FOCUS dataset column* MUST NOT contain commas or punctuation marks, except for a single decimal point when required for a decimal value.\"",
    "  L016: \"*FOCUS dataset column* MUST use a negative sign (-) to indicate a negative value.\"",
    "  L017: \"*FOCUS dataset column* MUST NOT include a positive sign (+) for a positive value.\"",
    "  L018: \"When column contains numeric values expressed in scientific notation, *FOCUS dataset column* MUST adhere to the following requirements:\"",
    "    L019: \"*FOCUS dataset column* MUST use E notation \\\"mEn\\\", where m is a real number and n is an integer exponent.\"",
    "    L020: \"*FOCUS dataset column* MUST use a negative sign (-) to indicate a negative exponent.\"",
    "    L021: \"*FOCUS dataset column* MUST NOT include a positive sign (+) for a positive exponent.\""
  ],
