  "0_outline_root": "ROOT: Billed Cost > Requirements",
  "0_outline_lines": [
    "L011: \"BilledCost MUST adhere to the following requirements:\"",
    "  L013: \"BilledCost MUST be of type Decimal.\"",
    "  L014: \"BilledCost MUST conform to [NumericFormat](#attributes.numericformat) requirements.\"",
    "  L015: \"BilledCost MUST NOT be null.\"",
    "  L016: \"BilledCost MUST be a valid decimal value.\"",
    "  L017: \"BilledCost MUST be 0 for *charges* where payments are received by a third party (e.g., marketplace transactions).\"",
    "  L018: \"BilledCost MUST be denominated in the BillingCurrency.\"",
    "  L019: \"The sum of the BilledCost for a given [InvoiceId](#datasets.costandusage.invoiceid) MUST match the sum of the payable amount provided in the corresponding invoice with the same id generated by the [InvoiceIssuerName](#datasets.costandusage.invoiceissuername).\""
  ],
