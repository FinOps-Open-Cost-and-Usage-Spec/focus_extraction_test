        "line_end": 28
      },
      "ref": "L028"
    },
    {
      "temp_id": "R005",
      "order": 5,
      "text": "Multiple discounts MAY apply to a row, but they MUST apply to the entire charge covered by that row.",
      "keyword": "MAY",
      "role": "requirement",
      "section_path": [
