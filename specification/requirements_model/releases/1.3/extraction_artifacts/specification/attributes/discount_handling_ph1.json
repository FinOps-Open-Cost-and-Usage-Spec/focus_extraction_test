        "line_end": 40
      },
      "ref": "L040"
    },
    {
      "temp_id": "R021",
      "order": 21,
      "text": "These rows MUST be represented with CommitmentDiscountStatus set to \"Unused\" and ChargeCategory set to \"Usage\".",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
