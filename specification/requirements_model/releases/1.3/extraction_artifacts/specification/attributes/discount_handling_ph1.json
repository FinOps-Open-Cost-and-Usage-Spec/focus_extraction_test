        "line_end": 39
      },
      "ref": "L039"
    },
    {
      "temp_id": "R018",
      "order": 18,
      "text": "CommitmentDiscountId MUST be set to the ID assigned to the discount.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
