        "line_end": 36
      },
      "ref": "L036"
    },
    {
      "temp_id": "R022",
      "order": 22,
      "text": "Such rows MUST have their CommitmentDiscountId and ResourceId set to the ID assigned to the *commitment discount*.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
