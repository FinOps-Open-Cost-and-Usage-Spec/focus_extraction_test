        "line_end": 35
      },
      "ref": "L035"
    },
    {
      "temp_id": "R019",
      "order": 19,
      "text": "ResourceId MUST be set to the ID of the resource that received the discount.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
