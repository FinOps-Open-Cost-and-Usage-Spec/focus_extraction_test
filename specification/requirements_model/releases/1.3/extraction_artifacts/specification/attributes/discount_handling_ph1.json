    },
    {
      "temp_id": "R004",
      "order": 4,
      "text": "All discounts applied to a row MUST apply to the entire charge.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
