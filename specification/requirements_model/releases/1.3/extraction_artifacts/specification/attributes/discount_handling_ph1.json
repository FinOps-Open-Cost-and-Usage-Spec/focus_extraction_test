    },
    {
      "temp_id": "R007",
      "order": 7,
      "text": "If a discount only applies to a portion of a charge, then the discounted portion of the charge MUST be split into a separate row.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
