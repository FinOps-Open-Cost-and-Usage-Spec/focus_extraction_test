        "line_end": 30
      },
      "ref": "L030"
    },
    {
      "temp_id": "R008",
      "order": 8,
      "text": "Each discount MUST be identifiable using existing FOCUS columns.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
