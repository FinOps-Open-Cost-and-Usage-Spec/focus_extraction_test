      },
      "provenance": {
        "line_start": 31,
        "line_end": 31
      },
      "ref": "L031"
    },
    {
      "temp_id": "R009",
      "order": 9,
      "text": "Rows with a *commitment discount* applied to them MUST include a CommitmentDiscountId.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 2,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 32,
        "line_end": 32
      },
      "ref": "L032"
    },
    {
      "temp_id": "R010",
      "order": 10,
      "text": "If a service provider applies a discount that cannot be represented by a FOCUS column, they SHOULD include additional columns to identify the source of the discount.",
      "keyword": "SHOULD",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 2,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 33,
        "line_end": 33
      },
      "ref": "L033"
    },
    {
      "temp_id": "R011",
      "order": 11,
      "text": "Purchased discounts (e.g., *commitment discounts*) MUST be amortized.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 34,
        "line_end": 34
      },
      "ref": "L034"
    },
    {
      "temp_id": "R012",
      "order": 12,
      "text": "The BilledCost MUST be 0 for any row where the commitment covers the entire cost for the charge period.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 35,
        "line_end": 35
      },
      "ref": "L035"
    },
    {
      "temp_id": "R013",
      "order": 13,
      "text": "The EffectiveCost MUST include the portion of the amortized purchase cost that applies to this row.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 36,
        "line_end": 36
      },
      "ref": "L036"
    },
    {
      "temp_id": "R014",
      "order": 14,
      "text": "The sum of the EffectiveCost for all rows where CommitmentDiscountStatus is \"Used\" or \"Unused\" for each CommitmentDiscountId over the entire commitment [*period*](#glossary:period) MUST be the same as the total BilledCost of the *commitment discount*.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 37,
        "line_end": 37
      },
      "ref": "L037"
    },
    {
      "temp_id": "R015",
      "order": 15,
      "text": "The CommitmentDiscountId and ResourceId MUST be set to the ID assigned to the *commitment discount*.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 38,
        "line_end": 38
      },
      "ref": "L038"
    },
    {
      "temp_id": "R016",
      "order": 16,
      "text": "ChargeCategory MUST be set to \"Purchase\" on rows that represent a purchase of a *commitment discount*.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 0,
        "bullet": "*"
      },
      "lead_in": {
        "ends_with_colon": false
      },
      "provenance": {
        "line_start": 34,
        "line_end": 34
      },
      "ref": "L034"
    },
    {
      "temp_id": "R017",
      "order": 17,
      "text": "CommitmentDiscountStatus MUST be \"Used\" for ChargeCategory \"Usage\" rows that received a reduced price from a commitment.",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Discount Handling",
        "Attribute ID",
        "Attribute Name",
        "Description",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
