      "ref": "L052"
    },
    {
      "temp_id": "R016",
      "order": 16,
      "text": "Custom columns SHOULD be listed after all FOCUS columns and SHOULD NOT be intermixed.",
      "keyword": "SHOULD NOT",
      "role": "requirement",
      "section_path": [
        "Column Handling",
