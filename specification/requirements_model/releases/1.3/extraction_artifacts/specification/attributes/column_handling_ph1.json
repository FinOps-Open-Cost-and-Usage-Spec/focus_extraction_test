    },
    {
      "temp_id": "R002",
      "order": 2,
      "text": "All columns defined by FOCUS MUST follow the following rules:",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Column Handling",
        "Requirements",
        "Column Names"
      ],
      "block": {
